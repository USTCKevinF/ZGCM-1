#!/usr/bin/env bash

# Self-contained runtime and external assets. Override defaults through the
# scheduler or edit this phase file; no other env file is sourced.
export SHARED_STORAGE_ROOT="${SHARED_STORAGE_ROOT:?set SHARED_STORAGE_ROOT}"
export MEGATRON_LM_ROOT="${MEGATRON_LM_ROOT:-${ZGCM_REPO_ROOT:?set by launch_train.sh}/Megatron-LM}"
export MEGATRON_VENV="${MEGATRON_VENV:-${SHARED_STORAGE_ROOT}/venvs/megatron}"
export TRANSFORMER_ENGINE_HOME="${TRANSFORMER_ENGINE_HOME:-}"
export FLASH_ATTN_V3_EGG="${FLASH_ATTN_V3_EGG:-}"
export TORCHRUN_BIN="${TORCHRUN_BIN:-${MEGATRON_VENV}/bin/torchrun}"
export TOKENIZER_PATH="${TOKENIZER_PATH:-${SHARED_STORAGE_ROOT}/models/glm51-tokenizer}"
export TRAIN_ROOT="${TRAIN_ROOT:-${SHARED_STORAGE_ROOT}/runs/zgcm7b}"
export MIDTRAIN_LONG64K_ROOT="${MIDTRAIN_LONG64K_ROOT:-${SHARED_STORAGE_ROOT}/datasets/zgcm7b/midtrain_mix64_v3_indexed}"
export MIDTRAIN_SHORT16K_ROOT="${MIDTRAIN_SHORT16K_ROOT:-${SHARED_STORAGE_ROOT}/datasets/zgcm7b/midtrain_mix16_v4_indexed}"
export DATA_ARGS_PATH="${DATA_ARGS_PATH:-${TRAIN_ROOT}/configs/midtrain_data_args.txt}"

export NUM_NODES="${NUM_NODES:-${WORLD_SIZE:-24}}"
export GPUS_PER_NODE="${GPUS_PER_NODE:-8}"
export NODE_RANK="${NODE_RANK:-${RANK:?set NODE_RANK or RANK}}"
export MASTER_ADDR="${MASTER_ADDR:?set MASTER_ADDR}"
export MASTER_PORT="${MASTER_PORT:-6247}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
export CUDA_DEVICE_MAX_CONNECTIONS="${CUDA_DEVICE_MAX_CONNECTIONS:-1}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export NCCL_IB_DISABLE="${NCCL_IB_DISABLE:-0}"
export NCCL_DEBUG="${NCCL_DEBUG:-WARN}"
export NVTE_CUDA_ARCHS="${NVTE_CUDA_ARCHS:-90}"
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"

# ZGCM-7B architecture.
export NUM_LAYERS=32
export HIDDEN_SIZE=4096
export FFN_HIDDEN_SIZE=11008
export NUM_ATTENTION_HEADS=32
export NUM_QUERY_GROUPS=8
export KV_CHANNELS=128
export VOCAB_SIZE=154880
export POSITION_EMBEDDING_TYPE=rope
export ROTARY_PERCENT=0.334
export NORM_EPSILON=1e-6
export WINDOW_SIZE="127,0"
export WINDOW_ATTN_SKIP_FREQ=6
export QK_LAYERNORM=1
export ATTENTION_OUTPUT_GATE=1
export ATTENTION_OUTPUT_GATE_ONLY_SWA=1
export ATTENTION_BACKEND=flash

# Midtrain optimizer, precision and common data settings.
export OPTIMIZER=muon
export LR=2.0e-5
export MIN_LR=2.0e-6
export LR_DECAY_STYLE=cosine
export WEIGHT_DECAY=0.1
export ADAM_BETA1=0.9
export ADAM_BETA2=0.95
export CLIP_GRAD=1.0
export SEED=6198
export MUON_MOMENTUM=0.9
export MUON_SCALE_MODE=spectral
export MUON_FP32_MATMUL_PREC=medium
export MUON_COEFFIC_TYPE=quintic
export MUON_NUM_NS_STEPS=5
export MUON_TP_MODE=blockwise
export MUON_EXTRA_SCALE_FACTOR=1.0
export MUON_SCALAR_OPTIMIZER=adam
export TRANSFORMER_IMPL=transformer_engine
export FP8_FORMAT=hybrid
export FP8_RECIPE=delayed
export FP8_AMAX_COMPUTE_ALGO=max
export FP8_AMAX_HISTORY_LEN=1024
export FP8_PARAM_GATHER=1
export NO_ROPE_FUSION=1
export USE_DISTRIBUTED_OPTIMIZER=1
export ENABLE_OVERLAP_GRAD_REDUCE=1
export ENABLE_OVERLAP_PARAM_GATHER=0
export ENABLE_CROSS_ENTROPY_LOSS_FUSION=1
export OVERRIDE_OPT_PARAM_SCHEDULER=1
export RERUN_MODE=disabled
export TRAIN_PROGRAM=pretrain_gpt.py
export REAL_DATA_PREFIX=""
export DATA_SPLIT="9999,1,0"
export NO_DATA_SHUFFLE=0
export DATA_NUM_WORKERS=4
export NUM_DATASET_BUILDER_THREADS=8
export SAVE_INTERVAL=500
export EVAL_INTERVAL=1000000
export EVAL_ITERS=0
export LOG_INTERVAL=10
export REQUIRE_LOAD_CHECKPOINT=0

# Stage-specific checkpoint, geometry and token budget.
export EXP_NAME=zgcm7b_midtrain_seq256k_tp2pp2cp4_gbs48_180p51b
export PRETRAINED_CHECKPOINT="${MIDTRAIN_SEQ64K_CHECKPOINT:-${TRAIN_ROOT}/results/zgcm7b_midtrain_seq64k_tp2cp4_gbs192_240b/checkpoints}"
export TP_SIZE=2
export PP_SIZE=2
export CP_SIZE=4
export CP_COMM_TYPE=a2a
export MICRO_BATCH_SIZE=1
export GLOBAL_BATCH_SIZE=48
export SEQ_LENGTH=262144
export MAX_POSITION_EMBEDDINGS=262144
export ROTARY_BASE=10000000
export TRAIN_SAMPLES=688560
export LR_WARMUP_SAMPLES=6864
export LR_DECAY_SAMPLES=688560
export ENABLE_RECOMPUTE=1
export RECOMPUTE_GRANULARITY="full"
export RECOMPUTE_METHOD="uniform"
export RECOMPUTE_NUM_LAYERS="1"
export CROSS_ENTROPY_FUSION_IMPL="te"

export OUTPUT_ROOT="${MIDTRAIN_SEQ256K_OUTPUT_ROOT:-${TRAIN_ROOT}/results/${EXP_NAME}}"
export SAVE_CHECKPOINT_DIR="${MIDTRAIN_SEQ256K_SAVE_CHECKPOINT_DIR:-${OUTPUT_ROOT}/checkpoints}"
export LOAD_CHECKPOINT_DIR="${MIDTRAIN_SEQ256K_LOAD_CHECKPOINT_DIR:-${SAVE_CHECKPOINT_DIR}}"
export TENSORBOARD_DIR="${MIDTRAIN_SEQ256K_TENSORBOARD_DIR:-${OUTPUT_ROOT}/tensorboard}"
export DATA_CACHE_DIR="${MIDTRAIN_SEQ256K_DATA_CACHE_DIR:-${OUTPUT_ROOT}/data-cache}"
export LOG_DIR="${MIDTRAIN_LOG_DIR:-${TRAIN_ROOT}/logs}"
