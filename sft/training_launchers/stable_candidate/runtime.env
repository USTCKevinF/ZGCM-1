# Machine-local runtime configuration. Set these five values before sourcing
# this file, or replace the empty defaults in a private working copy. Do not
# commit credentials or internal mount paths here.
ENV_ROOT="${ENV_ROOT:-}"
PROJECT_ROOT="${PROJECT_ROOT:-}"
SOURCE_CKPT_ROOT="${SOURCE_CKPT_ROOT:-}"
DATA_ROOT="${DATA_ROOT:-}"
TOKENIZER="${TOKENIZER:-}"

for required_name in ENV_ROOT PROJECT_ROOT SOURCE_CKPT_ROOT DATA_ROOT TOKENIZER; do
  if [[ -z "${!required_name:-}" ]]; then
    echo "runtime.env requires ${required_name}" >&2
    return 2 2>/dev/null || exit 2
  fi
done

PYTHON_BIN="${PYTHON_BIN:-${ENV_ROOT}/bin/python}"
CKPT_LOAD_ITER="${CKPT_LOAD_ITER:-8000}"
SOURCE_CKPT_ITER="${SOURCE_CKPT_ITER:-${SOURCE_CKPT_ROOT}/$(printf 'iter_%07d' "${CKPT_LOAD_ITER}")}"

SOURCE_DATA_ARGS="${SOURCE_DATA_ARGS:-${DATA_ROOT}/meta/indexed_per_split_data_args.modelware.json}"
INDEXED_DONE="${INDEXED_DONE:-${DATA_ROOT}/MODELWARE_READY}"
DATASET_METADATA="${DATASET_METADATA:-${INDEXED_DONE}}"
QCORE_ROOT="${QCORE_ROOT:-${DATA_ROOT}}"
THINK_ROOT="${THINK_ROOT:-${DATA_ROOT}}"
TOOL_ROOT="${TOOL_ROOT:-${DATA_ROOT}}"

PYTHON_SITE_PACKAGES="${PYTHON_SITE_PACKAGES:-${ENV_ROOT}/lib/python3.12/site-packages}"
FA3_OVERLAY="${FA3_OVERLAY:-${PYTHON_SITE_PACKAGES}}"
FA3_TRANSFORMER_ENGINE_HOME="${FA3_TRANSFORMER_ENGINE_HOME:-${PYTHON_SITE_PACKAGES}}"
TRANSFORMER_ENGINE_HOME="${TRANSFORMER_ENGINE_HOME:-${PYTHON_SITE_PACKAGES}}"

NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-eth0}"
GLOO_SOCKET_IFNAME="${GLOO_SOCKET_IFNAME:-eth0}"
NCCL_IB_GID_INDEX="${NCCL_IB_GID_INDEX:-7}"
MASTER_PORT="${MASTER_PORT:-29731}"
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
CUDA_DEVICE_MAX_CONNECTIONS="${CUDA_DEVICE_MAX_CONNECTIONS:-1}"
PYTORCH_ALLOC_CONF="${PYTORCH_ALLOC_CONF:-expandable_segments:True}"
PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
NCCL_DEBUG="${NCCL_DEBUG:-WARN}"
NCCL_IB_DISABLE="${NCCL_IB_DISABLE:-0}"
TORCH_NCCL_ENABLE_MONITORING="${TORCH_NCCL_ENABLE_MONITORING:-0}"
TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC="${TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC:-1800}"
TORCHDYNAMO_DISABLE="${TORCHDYNAMO_DISABLE:-1}"
TORCH_COMPILE_DISABLE="${TORCH_COMPILE_DISABLE:-1}"
TORCHDYNAMO_SUPPRESS_ERRORS="${TORCHDYNAMO_SUPPRESS_ERRORS:-1}"
NVTE_FRAMEWORK="${NVTE_FRAMEWORK:-pytorch}"
NVTE_CUDA_ARCHS="${NVTE_CUDA_ARCHS:-90}"
NVTE_FLASH_ATTN="${NVTE_FLASH_ATTN:-1}"
NVTE_FUSED_ATTN="${NVTE_FUSED_ATTN:-0}"
NVTE_UNFUSED_ATTN="${NVTE_UNFUSED_ATTN:-0}"
